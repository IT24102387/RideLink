# ==========================================
# Driver and Vehicle Service Environment Configuration
# ==========================================
# Server port
SERVER_PORT=

# MongoDB Database URI (Database-per-service boundary: yamu_driver_db)
# For local MongoDB: mongodb://localhost:27017/yamu_driver_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/yamu_driver_db?retryWrites=true&w=majority
MONGODB_URI=

# JWT Security Configuration (Must match Account Service secret)
JWT_SECRET=
JWT_EXPIRATION_MS=

# Inter-Service Communication Base URLs
ACCOUNT_SERVICE_URL=
RIDE_SERVICE_URL=
PAYMENT_SERVICE_URL=
