# ==========================================
# Ride Management Service Environment Configuration
# ==========================================
# Server port
SERVER_PORT=

# MongoDB Database URI (Database-per-service boundary: )
# For local MongoDB: mongodb://localhost:27017/
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/

# JWT Security Configuration (Must match Account Service secret)
JWT_SECRET=your jwt secret key
JWT_EXPIRATION_MS=86400000

# Inter-Service Communication Base URLs
ACCOUNT_SERVICE_URL=
DRIVER_SERVICE_URL=
PAYMENT_SERVICE_URL=
